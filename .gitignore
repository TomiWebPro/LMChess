# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets, signing, and local platform config (never commit)
.env
.env.*
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
Pods/

# Widget Preview related
.widget_preview/

# Stockfish embedded binaries (~100MB each, ~680MB total): fetched per-dev
# via `dart run tool/download_stockfish.dart <platform>`; keep locally for
# dev but never commit. README.md placeholders + LICENSE.GPLv3 stay tracked.
assets/engines/*/stockfish
assets/engines/*/stockfish.exe
